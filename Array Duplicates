class Solution {
  public:
    vector<int> findDuplicates(vector<int>& arr) {
        vector<int> temp;
        
        int n = arr.size();
        
        sort(arr.begin(), arr.end());
        
        for(int i=0; i<n-1; i++){
            if(arr[i] == arr[i+1]){
                temp.push_back(arr[i]);
            }
        }
        return temp;
    }
};
