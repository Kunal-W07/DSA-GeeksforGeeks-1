class Solution {
  public:
    Node* sortedMerge(Node* left, Node* right) {
        // code h
        Node* ans = new Node(-1);
        Node* curr = ans;
        
        if(left == 0){
            return right;
        }
        if(right == 0){
            return left;
        }
        
        while(left && right){
            if(left->data <= right->data){
                curr->next = left;
                curr = left;
                left = left->next;
            }else{
                curr->next = right;
                curr = right;
                right = right->next;
            }
        }
        
        if(left){
            curr->next = left;
        }
        
        if(right){
            curr->next = right;
        }
        
        return ans->next;
    }
};
