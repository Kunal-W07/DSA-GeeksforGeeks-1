   void ReverseUsingRecursion(queue<int> &q){
       if(q.empty()){
           //base case
           return;
       }
       
       int element = q.front();
       q.pop();
       
       ReverseUsingRecursion(q);
       
       q.push(element);
       
   }
   
   
    queue<int> reverseQueue(queue<int> &q) {
        // using stack
        
        // ReverseUsingStack(q);
