class Solution {
  public:
    int getSingle(vector<int>& arr) {
        unordered_map<int,int> freq;
        int n = arr.size();
        
        for(int i=0; i<n; i++){
            int num = arr[i];
            freq[num] = freq[num] + 1;
        }
        unordered_map<int,int> :: iterator it;
        int ans = 0;
        int key ;
        int values;
        for(it = freq.begin(); it!= freq.end(); it++){
            key = it->first;
            values = it->second; 
            if(values == 1){
            ans = key;
            return ans;
            
        }
        if(values == 3){
            ans = key;
            return ans;
        }
        }
        
