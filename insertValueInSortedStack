#include<iostream>
#include<stack>
using namespace std;

void insert(stack<int> &s, int val){
    if(s.empty()){
        s.push(val);
    }
    if(val > s.top()){
        s.push(val);
        return;
    }
    int temp = s.top();
    s.pop();
    insert(s,val);
    s.push(temp);
}

void print(stack<int> &s){
    while(!s.empty()){
        cout<<s.top()<<" ";
        s.pop();
    }

}

int main(){
    stack<int> s;
    s.push(10);
    s.push(20);
    s.push(30);
    s.push(40);
    s.push(50);

    int val = 23;

    insert(s,val);

    print(s);
    

}
