class Solution {
  public:
    // Function to delete middle element of a stack.
    
    void deleteMid(stack<int>& s , int count){
        //base condition
        if(count == 0){
            s.pop();
            return;
        }
        int topElement = s.top();
        s.pop();
        count--;
        
        deleteMid(s,count);
        // backtrack
        s.push(topElement);
        
    }
    void deleteMid(stack<int>& s) {
        // code here..
        int count = s.size()/2;
        deleteMid(s,count);
    }
};


