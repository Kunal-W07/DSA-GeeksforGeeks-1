// User function Template for C++
class Solution {
  public:
    int solve1(vector<int> arr , int n){
        int ans = INT_MAX;
        
        for(int i=0; i<n; i++){
            ans = min(ans,arr[i]);
        }
        return ans;
    }
    
    int solve2(vector<int> arr , int n){
        int ans = INT_MIN;
        
        for(int i=0; i<n; i++){
            ans = max(ans,arr[i]);
        }
        return ans;
    }
  
    pair<int, int> getMinMax(vector<int> arr) {
        // code here
        int n = arr.size();
        // if(n == 1){
        //     cout<< arr[0];
        // }
        
        int min_element = solve1(arr,n);
        int max_element = solve2(arr,n);
        
        pair<int,int>ans={min_element,max_element};
        
        return ans;
    }
};
