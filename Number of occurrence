class Solution {
public:
    void first(vector<int>& nums, int target, int &ans1){
        int s = 0;
        int e = nums.size() - 1;
       

        while(s <= e){
            int mid = s + (e - s) / 2;

            if(nums[mid] == target){
                ans1 = mid;
                e = mid - 1;
            }
            else if(target > nums[mid]){
                s = mid + 1;
            } else {
                e = mid - 1;
            }
        }
    }

    void last(vector<int>& nums, int target, int &ans2){
        int s = 0;
        int e = nums.size() - 1;
        

        while(s <= e){
            int mid = s + (e - s) / 2;

            if(nums[mid] == target){
                ans2 = mid;
                s = mid + 1;
            }
            else if(target > nums[mid]){
                s = mid + 1;
            } else {
                e = mid - 1;
            }
        }
    }

    int countFreq(vector<int>& nums, int target) {
        int ans1 = -1, ans2 = -1;
        first(nums, target, ans1);
        last(nums, target, ans2);

        if(ans1 == -1 || ans2 == -1){
            return 0; // target not found
        }

        return ans2 - ans1 + 1;
    }
};
