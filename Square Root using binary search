class Solution {
  public:
    int floorSqrt(int x) {
        // Your code goes here
        
        // using binary search
        
        int i=0;
        int j = x;
        int ans = -1;
        
        while(i<=j){
            int mid = i + (j-i) /2;
            //step 1 multiply mid * mid
            
            int multy = mid*mid;
            
            if(multy == x){
                return mid;
            }
            //step 2 check mid > x or mid < x
            if(multy < x){
                
                ans = mid;
                i = mid + 1;
                
            }else {
                j = mid -1;
            }
        }
        return ans;
    }
};
