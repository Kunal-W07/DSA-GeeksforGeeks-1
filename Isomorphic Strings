class Solution {
  public:
    // Function to check if two strings are isomorphic.
    bool areIsomorphic(string &s1, string &s2) {

        // using virtual hash table
        int hash[256] = {0};
        bool check[256] = {0};
        
         if (s1.size() != s2.size()) return false;
        
          for (int i = 0; i < s1.size(); i++) {
              
            if (hash[s1[i]] == 0 && check[s2[i]] == 0) {
                hash[s1[i]] = s2[i];
                check[s2[i]] = true; // Fixed: Assignment instead of comparison
            } 
            
            else if (hash[s1[i]] != s2[i]) { // Fixed: Added proper mapping check
                return false;
            }
        }
        return true;
    }
};
