class Solution {
  public:
  
    bool find(vector<int>& arr, int k, int n,int mid){
        int sum = 0;
        int count = 1;
        for(int i=0; i<n; i++){
            if(arr[i]>mid){
                return false;
            }
            if(sum + arr[i] > mid){
                count++;
                sum = arr[i];
                if(count > k){
                    return false;
                }
            }
            else{
                sum += arr[i];
            }
        }
        return true;
    }
    
    int minTime(vector<int>& arr, int k) {
        int n = arr.size();
       
        int s = 0;
         int e = accumulate(arr.begin(), arr.end(), 0);
        
        
        

        int ans =-1;
        while(s<=e){
            int mid = s +(e-s)/2;
            
            if(find(arr,k,n,mid)){
                ans = mid;
                e = mid-1;
            }else{
                s = mid+1;
            }
        }
        return ans;
    }
};
