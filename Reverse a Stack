class Solution{
public:

   void insertAtBottom(stack<int> &s , int val){
       if(s.empty()){
           s.push(val);
           return;
       }
       int topelement = s.top();
       s.pop();
       insertAtBottom(s,val);
       
       s.push(topelement);
   }
   
   void reverse(stack<int> &s){
       if(s.empty()){
           return;
       }
       int topE = s.top();
       s.pop();
       
       reverse(s);
       
       insertAtBottom(s,topE);
       
   }

    void Reverse(stack<int> &s){
        
       reverse(s);
        
    }
};
